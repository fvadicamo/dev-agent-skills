#!/usr/bin/env bash
# Pre-commit, two checks.
#
#   1. privacy: blocks a commit that stages a token from the local denylist
#      (.local/privacy-denylist.txt, gitignored). A no-op when that file is
#      absent, which is the case for every external contributor.
#   2. guardrails: runs the guard-destructive regression suite when the hook or
#      its tests are staged. A guardrail must never ship a regression.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass once:             git commit --no-verify
#
# Because core.hooksPath is set, `pre-commit install` refuses to run here by
# design, so the privacy script is invoked directly instead of through the
# pre-commit framework. One consequence: without the framework's stash step the
# check reads the working tree, not the staged blobs, so a token that exists
# only in an unstaged edit is still reported. It errs toward noticing.
set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# --- 1. privacy denylist -----------------------------------------------------
# The canonical script ships with the privacy-guard skill in this same repo, so
# it is called in place rather than copied into scripts/.
privacy="$root/plugins/privacy-guard/skills/privacy-guard/references/check_privacy.sh"
if [[ -f "$privacy" ]]; then
    files=()
    while IFS= read -r -d '' f; do files+=("$f"); done \
        < <(git diff --cached --name-only -z --diff-filter=d)
    if [[ ${#files[@]} -gt 0 ]]; then
        (cd "$root" && bash "$privacy" "${files[@]}") || exit 1
    fi
fi

# --- 2. guardrails regression suite ------------------------------------------
staged="$(git diff --cached --name-only)"
printf '%s\n' "$staged" | grep -qE '^plugins/guardrails/(hooks|tests)/' || exit 0

runner="$root/plugins/guardrails/tests/run.sh"
[[ -f "$runner" ]] || { echo "pre-commit: $runner missing, skipping" >&2; exit 0; }

echo "pre-commit: guardrails hook/tests changed - running regression suite..."
out="$(cd "$root" && bash "$runner" 2>&1)"; rc=$?

case $rc in
  0)
    printf '%s\n' "$out" | tail -1
    ;;
  2)
    printf '%s\n' "$out" >&2
    echo "pre-commit: could not run the suite (environment) - allowing commit; re-run it manually." >&2
    rc=0
    ;;
  *)
    printf '%s\n' "$out" >&2
    echo "pre-commit: guardrails tests FAILED - commit blocked. Override with 'git commit --no-verify'." >&2
    ;;
esac
exit $rc
